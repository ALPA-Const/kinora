# ==============================================
# KINORA — Environment Variables Template
# ==============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# --------------------------
# Application
# --------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --------------------------
# Database (PostgreSQL)
# --------------------------
DATABASE_URL=postgresql://kinora_user:changeme@localhost:5432/kinora_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --------------------------
# Redis (caching + sessions)
# --------------------------
REDIS_URL=redis://localhost:6379

# --------------------------
# JWT Authentication
# --------------------------
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------
# License Code System
# --------------------------
# Secret key used when generating license codes
# Generate with: openssl rand -hex 32
LICENSE_CODE_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
LICENSE_CODE_EXPIRY_DAYS=30

# --------------------------
# File Storage (AWS S3)
# --------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
AWS_S3_BUCKET=kinora-media
# OR use local storage in development:
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# --------------------------
# Email (notifications)
# --------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_API_KEY
EMAIL_FROM=noreply@eliteal.info

# --------------------------
# Push Notifications (FCM)
# --------------------------
FCM_SERVER_KEY=REPLACE_WITH_FCM_KEY
APNS_KEY_ID=REPLACE_WITH_APNS_KEY_ID
APNS_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID

# --------------------------
# AI / LLM (translation, memory vault tagging)
# --------------------------
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
# OR Claude:
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# --------------------------
# Translation API
# --------------------------
GOOGLE_TRANSLATE_API_KEY=REPLACE_WITH_GOOGLE_KEY

# --------------------------
# Maps (live location)
# --------------------------
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_KEY

# --------------------------
# Video/Voice Calls (WebRTC)
# --------------------------
# Twilio or Agora.io credentials
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_TOKEN
# OR Agora:
# AGORA_APP_ID=REPLACE_WITH_AGORA_APP_ID
# AGORA_APP_CERTIFICATE=REPLACE_WITH_AGORA_CERT

# --------------------------
# Rugby News Feed
# --------------------------
RUGBY_NEWS_API_KEY=REPLACE_WITH_NEWS_API_KEY
RUGBY_NEWS_API_URL=https://api.sportsdata.io/v3/rugby

# --------------------------
# Rate Limiting
# --------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
CODE_VALIDATION_RATE_LIMIT_MAX=10

# --------------------------
# Logging
# --------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty
